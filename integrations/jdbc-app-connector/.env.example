# Generic JDBC Application -> Veza OAA Integration
# Copy this file to .env and fill in real values.
#   cp .env.example .env && chmod 600 .env
# Typical install path: /opt/VEZA/JDBC/<Application Name>/scripts/.env

# Application identity in Veza
APPLICATION_NAME=Your Application Name
PROVIDER_NAME=JDBC Applications
DATASOURCE_NAME=Your Application Name

# Veza connection
VEZA_URL=https://your-veza-tenant.veza.com
VEZA_API_KEY=your_veza_api_key_here

# JDBC connection settings
DB_SERVER=your-database-hostname
DB_INSTANCE=
DB_NAME=your_database_name
DB_USER=your_service_account
DB_PASSWORD=your_service_account_password
DB_DOMAIN=
DB_JDBC_URL=
DB_JDBC_DRIVER_TYPE=mssql
DB_JDBC_DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
DB_JDBC_JAR=/opt/VEZA/JDBC/drivers/mssql-jdbc-12.8.1.jre11.jar

# SQL model: required and optional queries
# Required: users and roles
JDBC_USERS_QUERY=SELECT user_id, full_name, email FROM users
JDBC_ROLES_QUERY=SELECT role_id, role_name FROM roles

# Optional relationship queries
JDBC_GROUPS_QUERY=
JDBC_USER_ROLE_QUERY=SELECT user_id, role_id FROM user_role_map
JDBC_USER_GROUP_QUERY=
JDBC_ROLE_PERMISSION_QUERY=SELECT role_id, permission_name FROM role_permission_map
JDBC_USER_PERMISSION_QUERY=

# Column mapping (override only if column names differ)
USERS_COL_ID=user_id
USERS_COL_FULL_NAME=full_name
USERS_COL_EMAIL=email
USERS_COL_ROLE_ID=role_id
USERS_COL_GROUP_ID=group_id
ROLES_COL_ID=role_id
ROLES_COL_NAME=role_name
GROUPS_COL_ID=group_id
GROUPS_COL_NAME=group_name
USER_ROLE_COL_USER_ID=user_id
USER_ROLE_COL_ROLE_ID=role_id
USER_GROUP_COL_USER_ID=user_id
USER_GROUP_COL_GROUP_ID=group_id
ROLE_PERMISSION_COL_ROLE_ID=role_id
ROLE_PERMISSION_COL_PERMISSION=permission_name
USER_PERMISSION_COL_USER_ID=user_id
USER_PERMISSION_COL_PERMISSION=permission_name

# Optional static permissions list (comma-separated)
CUSTOM_PERMISSIONS=read,write,admin
